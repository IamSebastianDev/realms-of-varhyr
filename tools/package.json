{
  "name": "@realms/tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "generate": "node src/ensure-generated.mjs && tsx src/import-cards.ts",
    "schema:cards": "tsx src/generate-card-schema.ts",
    "check:css": "node src/check-css.mjs",
    "simulate": "tsx src/simulate.ts",
    "audit:bot": "tsx src/audit-bot.ts",
    "audit:balance": "tsx src/audit-first-player.ts",
    "audit:cards": "tsx src/audit-cards.ts",
    "compare:bot": "node --import tsx src/compare-bots.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@realms/content": "*",
    "@realms/contracts": "*",
    "@realms/core": "*",
    "@realms/draft": "*",
    "@realms/extensions": "*",
    "@realms/quest": "*",
    "@valibot/to-json-schema": "^1.8.0",
    "sharp": "^0.35.5",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
