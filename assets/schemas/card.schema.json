{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable card ID, independent of the folder or translated name."
    },
    "set": {
      "type": "string",
      "enum": [
        "foundations"
      ],
      "description": "Release ID from assets/sets/.",
      "default": "foundations"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "pattern": "\\S",
      "description": "English card name. The German name goes in data.de.json."
    },
    "deckLimitKey": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Shared copy-limit identity. Usually the card ID; reprints can share this key."
    },
    "type": {
      "enum": [
        "creature",
        "spell",
        "holding"
      ],
      "type": "string"
    },
    "factions": {
      "type": "array",
      "items": {
        "enum": [
          "black-host",
          "bright-marches",
          "conclave",
          "crownlands",
          "ember-fields",
          "horde",
          "mountain-clans",
          "winter-league",
          "neutral"
        ],
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Use named factions, [\"neutral\"], or [] for a neutral card. Neutral cannot be combined with a named faction."
    },
    "subtypes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Freeform subtypes, e.g. human, elf, leader or unicorn. They are not a closed enum; German labels live in the shared dictionary (packages/ui/src/i18n/de.json), not per card."
    },
    "legendary": {
      "type": "boolean",
      "description": "One copy per deck and collection, regardless of rarity."
    },
    "rarity": {
      "enum": [
        "common",
        "rare",
        "legendary"
      ],
      "type": "string",
      "description": "Booster rarity; independent of the legendary copy-limit flag."
    },
    "cost": {
      "type": "object",
      "properties": {
        "generic": {
          "type": "integer",
          "minimum": 0,
          "description": "Cost payable with any energy."
        },
        "factions": {
          "type": "object",
          "properties": {
            "black-host": {
              "type": "integer",
              "minimum": 0
            },
            "bright-marches": {
              "type": "integer",
              "minimum": 0
            },
            "conclave": {
              "type": "integer",
              "minimum": 0
            },
            "crownlands": {
              "type": "integer",
              "minimum": 0
            },
            "ember-fields": {
              "type": "integer",
              "minimum": 0
            },
            "horde": {
              "type": "integer",
              "minimum": 0
            },
            "mountain-clans": {
              "type": "integer",
              "minimum": 0
            },
            "winter-league": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "default": {},
          "description": "Faction-specific costs. neutral, generic and primal are not valid cost keys."
        }
      },
      "required": [
        "generic"
      ],
      "additionalProperties": false
    },
    "lore": {
      "type": "string",
      "description": "Optional flavor text. Rules text comes from the registered ability descriptions."
    },
    "abilities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ability"
      },
      "description": "Registered abilities. Parameters depend on the selected ID.",
      "default": []
    },
    "stats": {
      "type": "object",
      "properties": {
        "attack": {
          "type": "integer",
          "minimum": 0
        },
        "defense": {
          "type": "integer",
          "minimum": 0
        },
        "energyOutputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "black-host": {
                "type": "integer",
                "minimum": 0
              },
              "bright-marches": {
                "type": "integer",
                "minimum": 0
              },
              "conclave": {
                "type": "integer",
                "minimum": 0
              },
              "crownlands": {
                "type": "integer",
                "minimum": 0
              },
              "ember-fields": {
                "type": "integer",
                "minimum": 0
              },
              "horde": {
                "type": "integer",
                "minimum": 0
              },
              "mountain-clans": {
                "type": "integer",
                "minimum": 0
              },
              "winter-league": {
                "type": "integer",
                "minimum": 0
              },
              "neutral": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "default": [],
          "description": "Alternative printed production pools: choose one when channeling or receiving response energy. One pool with several keys produces all of them. [] means no printed production; Primal is an ability."
        }
      },
      "required": [
        "attack",
        "defense"
      ],
      "additionalProperties": false
    },
    "timing": {
      "type": "array",
      "items": {
        "enum": [
          "play",
          "response"
        ],
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "cast": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/spell-operation"
      },
      "minItems": 1,
      "description": "Spell operations resolved in list order."
    },
    "$schema": {
      "type": "string",
      "description": "Editor schema reference; ignored by the game importer.",
      "default": "../../schemas/card.schema.json"
    }
  },
  "required": [
    "id",
    "revision",
    "name",
    "deckLimitKey",
    "type",
    "factions",
    "subtypes",
    "legendary",
    "rarity",
    "cost",
    "abilities",
    "set"
  ],
