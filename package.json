{
  "name": "realms-of-varhyr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "node --import tsx scripts/simulate.ts",
    "assets": "node --import tsx scripts/import-cards.ts",
    "check:engine": "tsc --project tsconfig.engine.json",
    "audit:bot": "node --import tsx scripts/audit-bot.ts",
    "audit:balance": "node --import tsx scripts/audit-first-player.ts",
    "import:cards": "node --import tsx scripts/import-cards.ts",
    "prebuild": "npm run import:cards",
    "pretest": "npm run import:cards",
    "pretest:watch": "npm run import:cards",
    "presimulate": "npm run import:cards",
    "precheck:engine": "npm run import:cards",
    "preaudit:bot": "npm run import:cards",
    "preaudit:balance": "npm run import:cards"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.468.0",
    "peerjs": "^1.5.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
