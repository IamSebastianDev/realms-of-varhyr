{
  "name": "realms-of-varhyr",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@realms/web",
    "dev:studio": "turbo run dev --filter=@realms/studio",
    "build": "turbo run build --filter=@realms/web",
    "build:studio": "turbo run build --filter=@realms/studio",
    "preview": "npm run preview -w @realms/web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "npm run test:watch -w @realms/core",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:css": "npm run check:css -w @realms/tools",
    "check": "turbo run typecheck test && npm run lint && npm run format:check && npm run check:css",
    "assets": "npm run generate -w @realms/tools",
    "schema:cards": "npm run schema:cards -w @realms/tools",
    "simulate": "npm run simulate -w @realms/tools",
    "audit:bot": "npm run audit:bot -w @realms/tools",
    "audit:balance": "npm run audit:balance -w @realms/tools",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/node": "^26.6.5",
    "lefthook": "^2.0.0",
    "oxfmt": "latest",
    "oxlint": "^1.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "npm@10.9.4"
}
